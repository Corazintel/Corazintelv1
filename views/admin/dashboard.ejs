<section class="mx-auto max-w-6xl px-4 pt-8 pb-12">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl md:text-4xl font-display text-white">Admin</h1>
      <p class="mt-2 text-sm text-slate-300">Edit site content. Changes save to <code class="text-slate-400">src/data/content.json</code>.</p>
      <% if (saved) { %>
        <div class="mt-3 rounded-2xl border border-emerald-800 bg-emerald-900/20 p-3 text-emerald-200 text-sm">
          Saved.
        </div>
      <% } %>
    </div>

    <form method="post" action="/admin/logout">
      <button class="btn btn-ghost" type="submit">Logout</button>
    </form>
  </div>

  <form method="post" action="/admin/content" class="mt-8 grid gap-6 lg:grid-cols-12">
    <aside class="lg:col-span-3 rounded-3xl border border-slate-800 bg-slate-950 p-5 h-fit sticky top-24">
      <div class="text-sm text-slate-200 font-semibold">Sections</div>
      <div class="mt-3 text-sm text-slate-300 grid gap-2">
        <a class="hover:text-white" href="#brand">Brand</a>
        <a class="hover:text-white" href="#hero">Hero</a>
        <a class="hover:text-white" href="#categories">Category copy</a>
        <a class="hover:text-white" href="#testimonials">Testimonials</a>
        <a class="hover:text-white" href="#faq">FAQ</a>
        <a class="hover:text-white" href="#footer">Footer + Social + Contact</a>
      </div>

      <button class="btn btn-primary w-full mt-6" type="submit">Save changes</button>
    </aside>

    <div class="lg:col-span-9 grid gap-6">
      <div id="brand" class="rounded-3xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="text-white font-semibold">Brand</div>

        <label class="block text-sm text-slate-200 font-semibold mt-4" for="brand_slogan">Slogan</label>
        <input class="input mt-2" id="brand_slogan" name="brand_slogan" required value="<%= content.brand.slogan %>" />
      </div>

      <div id="hero" class="rounded-3xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="text-white font-semibold">Hero</div>

        <label class="block text-sm text-slate-200 font-semibold mt-4" for="hero_headline">Headline</label>
        <input class="input mt-2" id="hero_headline" name="hero_headline" required value="<%= content.hero.headline %>" />

        <label class="block text-sm text-slate-200 font-semibold mt-5" for="hero_subheadline">Subheadline</label>
        <textarea class="input mt-2 min-h-[110px]" id="hero_subheadline" name="hero_subheadline" required><%= content.hero.subheadline %></textarea>

        <div class="mt-5 text-slate-200 font-semibold text-sm">Benefit bullets (up to 8)</div>
        <% for (let i = 0; i < 8; i++) { %>
          <label class="block text-sm text-slate-200 font-semibold mt-4" for="benefit_<%= i+1 %>">Bullet <%= i+1 %></label>
          <input class="input mt-2" id="benefit_<%= i+1 %>" name="benefit_<%= i+1 %>" value="<%= (content.hero.benefits[i] || '') %>" />
        <% } %>
      </div>

      <div id="categories" class="rounded-3xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="text-white font-semibold">Category copy</div>

        <label class="block text-sm text-slate-200 font-semibold mt-4" for="cat_career_docs">Career & Documents</label>
        <textarea class="input mt-2 min-h-[90px]" id="cat_career_docs" name="cat_career_docs"><%= content.categoriesCopy.career_docs %></textarea>

        <label class="block text-sm text-slate-200 font-semibold mt-5" for="cat_credit_finance">Credit & Finance Support</label>
        <textarea class="input mt-2 min-h-[90px]" id="cat_credit_finance" name="cat_credit_finance"><%= content.categoriesCopy.credit_finance %></textarea>

        <label class="block text-sm text-slate-200 font-semibold mt-5" for="cat_tech_support">Tech Support</label>
        <textarea class="input mt-2 min-h-[90px]" id="cat_tech_support" name="cat_tech_support"><%= content.categoriesCopy.tech_support %></textarea>

        <label class="block text-sm text-slate-200 font-semibold mt-5" for="cat_beauty_wellness">Beauty & Wellness</label>
        <textarea class="input mt-2 min-h-[90px]" id="cat_beauty_wellness" name="cat_beauty_wellness"><%= content.categoriesCopy.beauty_wellness %></textarea>

        <label class="block text-sm text-slate-200 font-semibold mt-5" for="cat_digital_products">Digital Products</label>
        <textarea class="input mt-2 min-h-[90px]" id="cat_digital_products" name="cat_digital_products"><%= content.categoriesCopy.digital_products %></textarea>

        <label class="block text-sm text-slate-200 font-semibold mt-5" for="cat_branding_print">Branding & Print</label>
        <textarea class="input mt-2 min-h-[90px]" id="cat_branding_print" name="cat_branding_print"><%= content.categoriesCopy.branding_print %></textarea>
      </div>

      <div id="testimonials" class="rounded-3xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="text-white font-semibold">Testimonials (3)</div>

        <% const t = content.testimonials; %>
        <% for (let i = 0; i < 3; i++) { %>
          <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-950 p-4">
            <div class="text-slate-200 font-semibold text-sm">Testimonial <%= i+1 %></div>

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="t<%= i+1 %>_quote">Quote</label>
            <input class="input mt-2" id="t<%= i+1 %>_quote" name="t<%= i+1 %>_quote" value="<%= (t[i] && t[i].quote) || '' %>" />

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="t<%= i+1 %>_text">Text</label>
            <textarea class="input mt-2 min-h-[90px]" id="t<%= i+1 %>_text" name="t<%= i+1 %>_text"><%= (t[i] && t[i].text) || '' %></textarea>

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="t<%= i+1 %>_by">By</label>
            <input class="input mt-2" id="t<%= i+1 %>_by" name="t<%= i+1 %>_by" value="<%= (t[i] && t[i].by) || '' %>" />
          </div>
        <% } %>
      </div>

      <div id="faq" class="rounded-3xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="text-white font-semibold">FAQ (4)</div>
        <% const f = content.faq; %>
        <% for (let i = 0; i < 4; i++) { %>
          <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-950 p-4">
            <div class="text-slate-200 font-semibold text-sm">FAQ <%= i+1 %></div>

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="f<%= i+1 %>_q">Question</label>
            <input class="input mt-2" id="f<%= i+1 %>_q" name="f<%= i+1 %>_q" value="<%= (f[i] && f[i].q) || '' %>" />

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="f<%= i+1 %>_a">Answer</label>
            <textarea class="input mt-2 min-h-[90px]" id="f<%= i+1 %>_a" name="f<%= i+1 %>_a"><%= (f[i] && f[i].a) || '' %></textarea>
          </div>
        <% } %>
      </div>

      <div id="footer" class="rounded-3xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="text-white font-semibold">Footer + Social + Contact</div>

        <label class="block text-sm text-slate-200 font-semibold mt-4" for="footer_note">Footer note</label>
        <input class="input mt-2" id="footer_note" name="footer_note" value="<%= content.footer.note %>" />

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-slate-800 bg-slate-950 p-4">
            <div class="text-slate-200 font-semibold text-sm">Contact</div>

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="contact_email">Email</label>
            <input class="input mt-2" id="contact_email" name="contact_email" value="<%= content.contact.email %>" />

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="contact_phone">Phone</label>
            <input class="input mt-2" id="contact_phone" name="contact_phone" value="<%= content.contact.phone %>" />

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="contact_location">Location</label>
            <input class="input mt-2" id="contact_location" name="contact_location" value="<%= content.contact.location %>" />
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-950 p-4">
            <div class="text-slate-200 font-semibold text-sm">Social</div>

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="social_instagram">Instagram URL</label>
            <input class="input mt-2" id="social_instagram" name="social_instagram" value="<%= content.social.instagram %>" />

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="social_tiktok">TikTok URL</label>
            <input class="input mt-2" id="social_tiktok" name="social_tiktok" value="<%= content.social.tiktok %>" />

            <label class="block text-sm text-slate-200 font-semibold mt-4" for="social_youtube">YouTube URL</label>
            <input class="input mt-2" id="social_youtube" name="social_youtube" value="<%= content.social.youtube %>" />
          </div>
        </div>

        <button class="btn btn-primary w-full mt-6 lg:hidden" type="submit">Save changes</button>
      </div>
    </div>
  </form>
</section>
