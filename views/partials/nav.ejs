<nav
  class="sticky top-0 z-50 flex flex-wrap items-center justify-between gap-4 px-4 py-4 md:px-8 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-lg">
  <a class="flex items-center gap-2 font-display text-xl font-bold text-white hover:text-emerald-400 transition"
    href="/">
    <span class="text-2xl">💎</span>
    <%= typeof brand !=='undefined' ? brand.name : 'Corazintel' %>
  </a>

  <div class="hidden md:flex items-center gap-8 font-medium text-sm">
    <a class="text-slate-300 hover:text-white transition" href="/">Home</a>
    <a class="text-slate-300 hover:text-white transition" href="/#services">Services</a>
    <a class="text-slate-300 hover:text-white transition" href="/#about">About</a>
    <a class="text-slate-300 hover:text-white transition" href="/#faq">FAQs</a>
    <a class="text-slate-300 hover:text-white transition" href="/#contact">Contact</a>
  </div>

  <div class="flex items-center gap-4">
    <a href="/order-intake"
      class="hidden md:inline-flex items-center justify-center rounded-full bg-emerald-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 hover:shadow-emerald-500/20 transition-all transform hover:-translate-y-0.5">
      Start Order
    </a>

    <% if (typeof isAdmin !=='undefined' && isAdmin) { %>
      <a class="text-sm font-medium text-slate-300 hover:text-white" href="/admin">Admin</a>
      <form method="post" action="/admin/logout" class="inline">
        <button class="text-sm font-medium text-slate-400 hover:text-red-400" type="submit">Logout</button>
      </form>
      <% } %>

        <!-- Mobile Menu Button (Simple implementation) -->
        <button class="md:hidden text-slate-300 hover:text-white focus:outline-none"
          onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
            stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden w-full md:hidden pt-4 pb-2 border-t border-slate-800 mt-2">
    <div class="flex flex-col gap-4 text-center">
      <a class="text-slate-300 hover:text-white" href="/">Home</a>
      <a class="text-slate-300 hover:text-white" href="/#services">Services</a>
      <a class="text-slate-300 hover:text-white" href="/#about">About</a>
      <a class="text-slate-300 hover:text-white" href="/#faq">FAQs</a>
      <a class="text-slate-300 hover:text-white" href="/#contact">Contact</a>
      <a href="/order-intake"
        class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500">
        Start Order
      </a>
    </div>
  </div>
</nav>