<%
  const heroHeadline = (content && content.hero && content.hero.headline) || "Buy the help you need — career, credit, tech, beauty, and design.";
  const heroSub = (content && content.hero && content.hero.subheadline) || "Pick a category, choose a service, and check out securely with Stripe.";
  const benefits = (content && content.hero && content.hero.benefits) || [];
  const testimonials = (content && content.testimonials) || [];
  const faq = (content && content.faq) || [];
  const contact = (content && content.contact) || {};
  const social = (content && content.social) || {};
  const footerNote = (content && content.footer && content.footer.note) || "Secure checkout via Stripe. Mobile-first. Fast service flow.";
%>

<section class="mx-auto max-w-5xl px-4 pt-12 pb-16 md:pt-20">
  <div class="text-center">
    <h1 class="text-3xl md:text-5xl font-display font-bold text-white tracking-tight">
      <%= heroHeadline %>
    </h1>
    <p class="mt-6 text-lg text-slate-300 max-w-2xl mx-auto">
      <%= heroSub %>
    </p>
    <ul class="mt-8 grid gap-3 text-sm text-slate-200">
      <% (benefits || []).slice(0, 8).forEach(b => { %>
        <li class="flex gap-2 justify-center"><span class="text-emerald-300">✓</span> <%= b %></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 pb-16">
  <h2 class="text-2xl font-display font-semibold text-white mb-6">Categories</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% categories.forEach(c => { %>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/30 p-5 hover:border-slate-700 transition">
        <h3 class="font-semibold text-white"><%= c.label %></h3>
        <div class="mt-1 text-sm text-slate-300">
          <%= (content && content.categoriesCopy && content.categoriesCopy[c.key]) ? content.categoriesCopy[c.key] : c.description %>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<% if (testimonials.length > 0) { %>
<section class="mx-auto max-w-5xl px-4 pb-16">
  <h2 class="text-2xl font-display font-semibold text-white mb-6">What people say</h2>
  <div class="grid gap-4 md:grid-cols-3">
    <% testimonials.slice(0, 3).forEach(t => { %>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/30 p-5">
        <p class="font-semibold text-emerald-300">"<%= t.quote %>"</p>
        <p class="mt-2 text-sm text-slate-300"><%= t.text %></p>
        <p class="mt-2 text-xs text-slate-500">— <%= t.by %></p>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (faq.length > 0) { %>
<section class="mx-auto max-w-5xl px-4 pb-16">
  <h2 class="text-2xl font-display font-semibold text-white mb-6">FAQ</h2>
  <div class="space-y-4">
    <% faq.forEach(item => { %>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/30 p-5">
        <h3 class="font-semibold text-white"><%= item.q %></h3>
        <p class="mt-2 text-sm text-slate-300"><%= item.a %></p>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<footer class="border-t border-slate-800 bg-slate-900/30 py-8">
  <div class="mx-auto max-w-5xl px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-slate-400"><%= footerNote %></p>
    <div class="flex items-center gap-4">
      <% if (contact.email) { %><a class="text-slate-400 hover:text-white text-sm" href="mailto:<%= contact.email %>"><%= contact.email %></a><% } %>
      <% if (social.instagram && social.instagram !== '#') { %><a class="text-slate-400 hover:text-white text-sm" href="<%= social.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
      <% if (social.tiktok && social.tiktok !== '#') { %><a class="text-slate-400 hover:text-white text-sm" href="<%= social.tiktok %>" target="_blank" rel="noopener">TikTok</a><% } %>
      <% if (social.youtube && social.youtube !== '#') { %><a class="text-slate-400 hover:text-white text-sm" href="<%= social.youtube %>" target="_blank" rel="noopener">YouTube</a><% } %>
    </div>
  </div>
</footer>
