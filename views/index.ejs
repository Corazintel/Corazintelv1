  <!-- Golden Thread Positioning -->
  <div
    class="bg-black text-white text-center py-3 text-xs md:text-sm uppercase tracking-[0.2em] border-b border-white/10 sticky top-14 z-40">
    <%= positioning %>
  </div>

  <!-- HERO SECTION -->
  <section class="relative mx-auto max-w-7xl px-4 pt-16 pb-24 md:pt-24 lg:pt-32">
    <div class="text-center max-w-4xl mx-auto">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800/50 px-3 py-1 text-sm <%= goldText %> mb-6">
        <span class="flex h-2 w-2 rounded-full <%= goldBg %>"></span>
        Accepting New Clients
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-display font-bold text-white tracking-tight leading-tight mb-8">
        <%= heroHeadline %>
      </h1>

      <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        <%= heroSub %>
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="#branches"
          class="btn <%= goldBg %> text-black font-bold text-lg px-8 py-4 shadow-lg shadow-amber-500/20 hover:scale-105 transform transition-all duration-300">
          Explore Services
        </a>
        <a href="#about" class="btn btn-ghost text-lg px-8 py-4">
          Our Story
        </a>
      </div>

      <!-- Benefits Grid -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 text-left">
        <% (benefits || []).slice(0, 4).forEach(function(b) { %>
          <div class="flex items-center gap-3 bg-slate-900/40 p-3 rounded-lg border border-slate-800/50">
            <div class="flex-shrink-0 <%= goldText %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
            </div>
            <span class="text-sm font-medium text-slate-300">
              <%= b %>
            </span>
          </div>
          <% }) %>
      </div>
    </div>
  </section>

  <!-- SERVICES HUB (BRANCHES) -->
  <section id="branches" class="relative py-20 bg-slate-900/30">
    <div class="mx-auto max-w-7xl px-4">
      <div class="text-center mb-16">
        <h2 class="text-sm font-semibold <%= goldText %> tracking-wider uppercase mb-2">Our Capabilities</h2>
        <h3 class="text-3xl md:text-4xl font-display font-bold text-white">Choose Your Path</h3>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% branchKeys.forEach(function(key) { var branch=branches[key]; %>
          <a href="<%= branch.path %>"
            class="group relative rounded-3xl border border-slate-800 bg-slate-900/50 p-6 hover:border-amber-500/50 hover:bg-slate-800/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-amber-500/10 block">
            <div
              class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500/10 <%= goldText %> group-hover:<%= goldBg %> group-hover:text-black transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="w-6 h-6">
                <%- getIcon(key) %>
              </svg>
            </div>

            <h3 class="text-xl font-bold text-white mb-2 group-hover:<%= goldText %> transition-colors">
              <%= branch.title %>
            </h3>

            <p class="text-sm text-slate-400 leading-relaxed mb-4">
              <%= branch.desc %>
            </p>

            <span class="inline-flex items-center text-sm font-semibold <%= goldText %> group-hover:text-amber-300">
              View details
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                stroke="currentColor" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
          <% }) %>
      </div>
    </div>
  </section>

  <!-- THE PROCESS (Directory style) -->
  <section class="py-20 bg-slate-900">
    <div class="mx-auto max-w-7xl px-4">
      <div class="text-center mb-16">
        <h2 class="text-sm font-semibold <%= goldText %> tracking-wider uppercase mb-2">Simple & Effective</h2>
        <h3 class="text-3xl md:text-4xl font-display font-bold text-white">How It Works</h3>
      </div>

      <div class="grid md:grid-cols-3 gap-8 relative">
        <% processSteps.forEach(function(step, index) { %>
          <div class="relative z-10 p-6 text-center border border-slate-800 rounded-2xl bg-slate-900/50">
            <div
              class="w-16 h-16 mx-auto <%= goldBg %> rounded-full flex items-center justify-center text-black font-bold text-2xl mb-6 shadow-lg shadow-amber-500/20">
              <%= index + 1 %>
            </div>
            <h4 class="text-xl font-bold text-white mb-3">
              <%= step.title %>
            </h4>
            <p class="text-slate-400">
              <%= step.desc %>
            </p>
          </div>
          <% }) %>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section id="about" class="py-20">
    <div class="mx-auto max-w-5xl px-4">
      <div
        class="rounded-3xl bg-slate-900 border border-slate-800 p-8 md:p-12 text-center md:text-left md:flex items-center gap-12">
        <div class="md:w-1/2 mb-8 md:mb-0">
          <div
            class="inline-block rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 p-1 shadow-lg transform rotate-3">
            <div class="bg-black p-4 rounded-xl">
              <span class="text-4xl">💎</span>
            </div>
          </div>
        </div>
        <div class="md:w-1/2">
          <h2 class="text-3xl font-display font-bold text-white mb-4">Why Corazintel?</h2>
          <p class="text-slate-300 mb-6 leading-relaxed">
            We bridge the gap between business, finance, and wellness. Our unique multi-disciplinary approach ensures
            you get holistic solutions for your lifestyle and legacy.
          </p>
          <div class="grid grid-cols-2 gap-6">
            <div>
              <h4 class="text-2xl font-bold text-white">500+</h4>
              <p class="text-slate-500 text-sm">Clients Served</p>
            </div>
            <div>
              <h4 class="text-2xl font-bold text-white">4.9/5</h4>
              <p class="text-slate-500 text-sm">Certified Excellence</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer id="contact" class="border-t border-slate-800 bg-slate-950 pt-16 pb-8">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-12 md:grid-cols-4 mb-16">
        <div class="md:col-span-2">
          <a class="flex items-center gap-2 font-display text-2xl font-bold text-white mb-6" href="/">
            <span class="text-3xl">💎</span>
            Corazintel
          </a>
          <p class="text-slate-400 max-w-md leading-relaxed mb-6">
            <%= positioning %>
          </p>
        </div>

        <div>
          <h3 class="font-bold text-white mb-6">Services</h3>
          <ul class="space-y-4 text-sm text-slate-400">
            <% branchKeys.forEach(function(key) { %>
              <li><a href="<%= branches[key].path %>" class="hover:<%= goldText %>">
                  <%= branches[key].title %>
                </a></li>
              <% }) %>
          </ul>
        </div>

        <div>
          <h3 class="font-bold text-white mb-6">Contact</h3>
          <ul class="space-y-4 text-sm text-slate-400">
            <li class="flex items-center gap-2">
              <a href="mailto:contact@corazintel.com" class="hover:text-white">contact@corazintel.com</a>
            </li>
          </ul>
        </div>
      </div>

      <div
        class="border-t border-slate-900 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
        <p>&copy; 2026 Corazintel. All rights reserved.</p>
      </div>
    </div>
  </footer>